# ==============================
# Ecosphere Root .gitignore
# ==============================

# ---- Environment Variables (NEVER COMMIT SECRETS) ----
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
*.pdb

# Python virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Python packaging
*.egg-info/
dist/
build/
*.egg
MANIFEST

# Python testing
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ---- Node.js / Frontend ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Next.js
.next/
out/
.turbo/

# Build output
dist/
build/

# ---- IDE / Editor ----
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# ---- Logs ----
*.log
logs/
*.log.*

# ---- OS ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ---- Misc ----
*.tmp
*.bak
*.orig
