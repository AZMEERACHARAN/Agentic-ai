# ==============================
# Ecosphere AI Service — Environment Variables
# ==============================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# --- Google Gemini ---
# Your Gemini API key (found in: Google AI Studio → API Keys)
# WARNING: This is a SECRET. Server-side only. Never expose to frontend or browser.
GEMINI_API_KEY=

# --- Supabase ---
# Documented here for future use when the AI service requires database access.
# Your Supabase project URL (found in: Project Settings → API)
SUPABASE_URL=

# Your Supabase service role key (found in: Project Settings → API → Service Role)
# WARNING: This is a SECRET. Server-side only. Never expose to frontend or browser.
SUPABASE_SERVICE_ROLE_KEY=
